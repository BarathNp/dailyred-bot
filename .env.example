# Copy this file to .env and fill it in. Never share or commit .env.

# Bot token from the Discord Developer Portal (Bot page → Reset Token).
DISCORD_TOKEN=

# Channel for the daily post (right-click the channel → Copy Channel ID).
# Optional if you use /dailyred setchannel instead.
CHANNEL_ID=

# Your time zone (a name from https://en.wikipedia.org/wiki/List_of_tz_database_time_zones).
# The team changes at midnight in this time zone, like on the website.
TZ=America/New_York

# When to post each day, 24-hour HH:MM in TZ.
POST_TIME=09:00

# Optional: where the bot keeps state.json and cached teams (default: ./state).
# STATE_DIR=state

# Optional: the date of "Daily Red No. 1", used for the number in the title
# only if the website doesn't show one.
# DAILYRED_DAY_ONE=2026-10-11
